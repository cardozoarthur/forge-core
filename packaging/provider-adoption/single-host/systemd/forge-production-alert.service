[Unit]
Description=Check Forge production health and alert through Telegram
Documentation=https://github.com/cardozoarthur/forge-core/blob/main/packaging/provider-adoption/single-host/README.md
After=network-online.target forge-ops.service forge-backup.timer
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=2min
ExecStart=/usr/local/libexec/forge-production-alert
LoadCredential=forge-telegram-alert:/etc/forge/credentials/forge-telegram-alert
StateDirectory=forge-production-alert
StateDirectoryMode=0700
Environment=FORGE_STORE_PATH=/var/lib/forge/forge.sqlite
Environment=FORGE_BACKUP_DIR=/var/backups/forge
Environment=FORGE_OFFHOST_MAX_AGE_SECONDS=86400

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadOnlyPaths=-/var/lib/forge
ReadOnlyPaths=-/var/backups/forge
ReadWritePaths=/var/lib/forge-production-alert
LimitCORE=0
