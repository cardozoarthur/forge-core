#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C
umask 077

readonly EXIT_USAGE=64
readonly EXIT_REMOTE=69
readonly EXIT_CONFLICT=73
readonly DIGEST_SUFFIX=".forge-sha256"

operation=""
source_path=""
destination=""
object_name=""
expected_sha256=""
output_path=""
sha256_output_path=""
destination_path=""
remote_object_path=""
remote_digest_path=""
active_remote_object=""
active_remote_digest=""
active_download_object=""
active_download_digest=""
rollback_output=""
rollback_digest_output=""
mount_identity_file="${FORGE_DIRECTORY_MOUNT_IDENTITY_FILE:-}"
mount_target=""
mount_source=""
mount_fstype=""
mount_fsid=""

fail() {
  local status="$1"
  shift
  printf 'forge-directory-offhost-uploader: %s\n' "$*" >&2
  exit "$status"
}

same_file() {
  local left="$1"
  local right="$2"

  [[ -e "$left" && -e "$right" && "$left" -ef "$right" ]]
}

cleanup() {
  if [[ -n "$rollback_digest_output" &&
    -n "$active_download_digest" ]] &&
    same_file "$active_download_digest" "$rollback_digest_output"; then
    rm -f -- "$rollback_digest_output"
  fi
  if [[ -n "$rollback_output" &&
    -n "$active_download_object" ]] &&
    same_file "$active_download_object" "$rollback_output"; then
    rm -f -- "$rollback_output"
  fi
  if [[ -n "$active_remote_object" ]]; then
    rm -f -- "$active_remote_object"
  fi
  if [[ -n "$active_remote_digest" ]]; then
    rm -f -- "$active_remote_digest"
  fi
  if [[ -n "$active_download_object" ]]; then
    rm -f -- "$active_download_object"
  fi
  if [[ -n "$active_download_digest" ]]; then
    rm -f -- "$active_download_digest"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

require_value() {
  local option="$1"
  local remaining="$2"

  ((remaining >= 2)) ||
    fail "$EXIT_USAGE" "$option requires exactly one value"
}

parse_arguments() {
  (($# >= 1)) ||
    fail "$EXIT_USAGE" "expected operation: upload, verify, or download"
  operation="$1"
  shift

  case "$operation" in
    upload | verify | download) ;;
    *) fail "$EXIT_USAGE" "unsupported operation" ;;
  esac

  local seen_source=0
  local seen_destination=0
  local seen_object=0
  local seen_sha256=0
  local seen_output=0
  local seen_sha256_output=0

  while (($# > 0)); do
    case "$1" in
      --source)
        require_value "$1" "$#"
        ((seen_source == 0)) ||
          fail "$EXIT_USAGE" "duplicate --source"
        source_path="$2"
        seen_source=1
        shift 2
        ;;
      --destination)
        require_value "$1" "$#"
        ((seen_destination == 0)) ||
          fail "$EXIT_USAGE" "duplicate --destination"
        destination="$2"
        seen_destination=1
        shift 2
        ;;
      --object)
        require_value "$1" "$#"
        ((seen_object == 0)) ||
          fail "$EXIT_USAGE" "duplicate --object"
        object_name="$2"
        seen_object=1
        shift 2
        ;;
      --sha256)
        require_value "$1" "$#"
        ((seen_sha256 == 0)) ||
          fail "$EXIT_USAGE" "duplicate --sha256"
        expected_sha256="$2"
        seen_sha256=1
        shift 2
        ;;
      --output)
        require_value "$1" "$#"
        ((seen_output == 0)) ||
          fail "$EXIT_USAGE" "duplicate --output"
        output_path="$2"
        seen_output=1
        shift 2
        ;;
      --sha256-output)
        require_value "$1" "$#"
        ((seen_sha256_output == 0)) ||
          fail "$EXIT_USAGE" "duplicate --sha256-output"
        sha256_output_path="$2"
        seen_sha256_output=1
        shift 2
        ;;
      *)
        fail "$EXIT_USAGE" "unknown or positional argument"
        ;;
    esac
  done

  case "$operation" in
    upload)
      ((seen_source == 1 && seen_destination == 1 &&
        seen_object == 1 && seen_sha256 == 1 &&
        seen_output == 0 && seen_sha256_output == 0)) ||
        fail "$EXIT_USAGE" \
          "upload requires --source, --destination, --object, and --sha256"
      ;;
    verify)
      ((seen_source == 0 && seen_destination == 1 &&
        seen_object == 1 && seen_sha256 == 0 &&
        seen_output == 0 && seen_sha256_output == 0)) ||
        fail "$EXIT_USAGE" \
          "verify requires only --destination and --object"
      ;;
    download)
      ((seen_source == 0 && seen_destination == 1 &&
        seen_object == 1 && seen_sha256 == 0 &&
        seen_output == 1 && seen_sha256_output == 1)) ||
        fail "$EXIT_USAGE" \
          "download requires --destination, --object, --output, and --sha256-output"
      ;;
  esac
}

audit_no_symlink_components() {
  local path="$1"
  local label="$2"
  local component="$path"

  while true; do
    [[ ! -L "$component" ]] ||
      fail "$EXIT_USAGE" "$label must contain no symbolic links"
    [[ "$component" = "/" ]] && break
    component="${component%/*}"
    [[ -n "$component" ]] || component="/"
  done
}

audit_private_destination_permissions() {
  local path="$1"
  local label="$2"
  local expected_uid="$EUID"
  local component=""
  local component_uid=""
  local component_mode=""

  [[ "$(stat -c '%u' -- "$path")" -eq "$expected_uid" ]] ||
    fail "$EXIT_USAGE" "$label must be owned by the uploader account"
  [[ "$(stat -c '%a' -- "$path")" = 700 ]] ||
    fail "$EXIT_USAGE" "$label mode must be exactly 0700"

  component="${path%/*}"
  [[ -n "$component" ]] || component="/"
  while true; do
    [[ ! -L "$component" ]] ||
      fail "$EXIT_USAGE" "$label ancestor must not be a symbolic link"
    component_uid="$(stat -c '%u' -- "$component")"
    [[ "$component_uid" -eq 0 || "$component_uid" -eq "$expected_uid" ]] ||
      fail "$EXIT_USAGE" "$label ancestor must be owned by root or the uploader account"
    component_mode="$(stat -c '%a' -- "$component")"
    (( (8#$component_mode & 0022) == 0 )) ||
      fail "$EXIT_USAGE" "$label ancestor must not be writable by group or other"
    [[ "$component" = "/" ]] && break
    component="${component%/*}"
    [[ -n "$component" ]] || component="/"
  done
}

validate_canonical_directory() {
  local path="$1"
  local label="$2"
  local canonical_path=""

  [[ "$path" = /* &&
    "$path" != *$'\n'* &&
    "$path" != *$'\r'* &&
    -d "$path" &&
    ! -L "$path" ]] ||
    fail "$EXIT_USAGE" "$label must be an existing absolute non-symlink directory"
  canonical_path="$(realpath -e -- "$path")" ||
    fail "$EXIT_USAGE" "$label cannot be resolved"
  [[ "$canonical_path" = "$path" ]] ||
    fail "$EXIT_USAGE" "$label must be canonical and contain no traversal"
  audit_no_symlink_components "$path" "$label"
}

validate_destination_and_object() {
  [[ "$destination" == file:///* &&
    "$destination" != *$'\n'* &&
    "$destination" != *$'\r'* ]] ||
    fail "$EXIT_USAGE" "destination must be file:///absolute/path"

  destination_path="${destination#file://}"
  [[ "$destination_path" =~ ^/[A-Za-z0-9._/@:+,-]+$ &&
    "$destination_path" != *"//"* &&
    "$destination_path" != *"/./"* &&
    "$destination_path" != *"/../"* &&
    "$destination_path" != */"." &&
    "$destination_path" != */".." &&
    "$destination_path" != */ ]] ||
    fail "$EXIT_USAGE" \
      "destination must be an unencoded canonical file URI path"
  validate_canonical_directory "$destination_path" "destination"
  audit_private_destination_permissions "$destination_path" "destination"

  [[ ${#object_name} -le 200 &&
    "$object_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ &&
    "$object_name" != "." &&
    "$object_name" != ".." &&
    "$object_name" != *..* &&
    "$object_name" != *"$DIGEST_SUFFIX" ]] ||
    fail "$EXIT_USAGE" "invalid object name"

  remote_object_path="$destination_path/$object_name"
  remote_digest_path="$remote_object_path$DIGEST_SUFFIX"
}

validate_canonical_input_file() {
  local path="$1"
  local label="$2"
  local canonical_path=""

  [[ "$path" = /* &&
    "$path" != *$'\n'* &&
    "$path" != *$'\r'* &&
    -f "$path" &&
    ! -L "$path" ]] ||
    fail "$EXIT_USAGE" "$label must be an absolute non-symlink regular file"
  canonical_path="$(realpath -e -- "$path")" ||
    fail "$EXIT_USAGE" "$label cannot be resolved"
  [[ "$canonical_path" = "$path" ]] ||
    fail "$EXIT_USAGE" "$label must be canonical and contain no symlink"
  audit_no_symlink_components "$path" "$label"
}

read_mount_field() {
  local path="$1"
  local field="$2"
  local -a field_lines=()

  mapfile -t field_lines < <(
    findmnt \
      --noheadings \
      --raw \
      --first-only \
      --output "$field" \
      --target "$path"
  )
  [[ ${#field_lines[@]} -eq 1 && -n "${field_lines[0]}" ]] ||
    fail "$EXIT_REMOTE" "cannot resolve current destination mount $field"
  [[ "${field_lines[0]}" != *$'\r'* ]] ||
    fail "$EXIT_REMOTE" "current destination mount $field contains a carriage return"

  printf '%s' "${field_lines[0]}"
}

load_mount_identity() {
  local -a identity_lines=()

  [[ -n "$mount_identity_file" ]] ||
    fail "$EXIT_REMOTE" "FORGE_DIRECTORY_MOUNT_IDENTITY_FILE is required"
  validate_canonical_input_file "$mount_identity_file" "mount identity file"
  mapfile -t identity_lines <"$mount_identity_file"
  [[ ${#identity_lines[@]} -eq 5 &&
    "${identity_lines[0]}" = "forge-directory-mount-v1" &&
    "${identity_lines[1]}" = target=* &&
    "${identity_lines[2]}" = source=* &&
    "${identity_lines[3]}" = fstype=* &&
    "${identity_lines[4]}" = fsid=* ]] ||
    fail "$EXIT_REMOTE" "mount identity file has an invalid schema"

  mount_target="${identity_lines[1]#target=}"
  mount_source="${identity_lines[2]#source=}"
  mount_fstype="${identity_lines[3]#fstype=}"
  mount_fsid="${identity_lines[4]#fsid=}"
  [[ "$mount_target" = /* &&
    "$mount_target" != "/" &&
    "$mount_target" =~ ^/[A-Za-z0-9._/@:+,-]+$ &&
    "$mount_target" != *"//"* &&
    "$mount_target" != *"/./"* &&
    "$mount_target" != *"/../"* &&
    "$mount_target" != */"." &&
    "$mount_target" != */".." &&
    "$mount_target" != */ &&
    -n "$mount_source" &&
    "$mount_source" != *$'\r'* &&
    "$mount_fstype" =~ ^[A-Za-z0-9._+-]+$ &&
    "$mount_fsid" =~ ^[0-9A-Fa-f]+$ ]] ||
    fail "$EXIT_REMOTE" "mount identity contains invalid values"
  case "$destination_path" in
    "$mount_target"/*) ;;
    *)
      fail "$EXIT_REMOTE" "destination must be below its persisted mount target"
      ;;
  esac
}

require_current_mount_identity() {
  local current_target=""
  local current_source=""
  local current_fstype=""
  local current_fsid_before=""
  local current_fsid_after=""

  current_fsid_before="$(stat -f -c '%i' -- "$destination_path")" ||
    fail "$EXIT_REMOTE" "destination filesystem identity is unavailable"
  current_target="$(read_mount_field "$mount_target" TARGET)"
  current_source="$(read_mount_field "$mount_target" SOURCE)"
  current_fstype="$(read_mount_field "$mount_target" FSTYPE)"
  current_fsid_after="$(stat -f -c '%i' -- "$destination_path")" ||
    fail "$EXIT_REMOTE" "destination filesystem identity is unavailable"

  [[ "$current_target" = "$mount_target" &&
    "$current_source" = "$mount_source" &&
    "$current_fstype" = "$mount_fstype" &&
    "$current_fsid_before" = "$mount_fsid" &&
    "$current_fsid_after" = "$mount_fsid" ]] ||
    fail "$EXIT_REMOTE" "destination mount identity changed or is unavailable"
}

validate_output_path() {
  local path="$1"
  local label="$2"
  local parent=""
  local base=""

  [[ "$path" = /* &&
    "$path" != *$'\n'* &&
    "$path" != *$'\r'* ]] ||
    fail "$EXIT_USAGE" "$label must be an absolute path"
  if [[ -e "$path" || -L "$path" ]]; then
    [[ ! -L "$path" && -f "$path" ]] ||
      fail "$EXIT_USAGE" "$label existing entry must be a non-symlink regular file"
  fi

  parent="${path%/*}"
  [[ -n "$parent" ]] || parent="/"
  base="${path##*/}"
  [[ -n "$base" && "$base" != "." && "$base" != ".." ]] ||
    fail "$EXIT_USAGE" "$label has an invalid basename"
  validate_canonical_directory "$parent" "$label parent"
  [[ -w "$parent" ]] ||
    fail "$EXIT_USAGE" "$label parent must be writable"
}

validate_remote_entry() {
  local path="$1"
  local label="$2"

  [[ ! -L "$path" ]] ||
    fail "$EXIT_REMOTE" "$label must not be a symbolic link"
  if [[ -e "$path" ]]; then
    [[ -f "$path" ]] ||
      fail "$EXIT_REMOTE" "$label must be a regular file"
  fi
}

calculate_sha256() {
  local path="$1"
  local digest_line=""
  local digest=""

  digest_line="$(sha256sum <"$path")" || return 1
  digest="${digest_line%% *}"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$digest"
}

read_exact_sha256() {
  local path="$1"
  local digest=""
  local extra=""
  local descriptor=""

  exec {descriptor}<"$path" || return 1
  if ! IFS= read -r digest <&"$descriptor"; then
    exec {descriptor}<&-
    return 1
  fi
  if IFS= read -r extra <&"$descriptor" || [[ -n "$extra" ]]; then
    exec {descriptor}<&-
    return 1
  fi
  exec {descriptor}<&-

  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$digest"
}

sync_path() {
  local path="$1"
  local label="$2"

  sync -f -- "$path" >/dev/null 2>&1 ||
    fail "$EXIT_REMOTE" "cannot durably sync $label"
}

stage_remote_pair() {
  local source_sha256=""
  local staged_sha256=""

  validate_canonical_input_file "$source_path" "source"
  [[ "$expected_sha256" =~ ^[0-9a-f]{64}$ ]] ||
    fail "$EXIT_USAGE" "sha256 must be exactly one lowercase SHA-256"
  source_sha256="$(calculate_sha256 "$source_path")" ||
    fail "$EXIT_USAGE" "cannot calculate source SHA-256"
  [[ "$source_sha256" = "$expected_sha256" ]] ||
    fail "$EXIT_USAGE" "source SHA-256 does not match --sha256"
  require_current_mount_identity
  [[ -w "$destination_path" ]] ||
    fail "$EXIT_REMOTE" "destination is not writable"

  active_remote_object="$(
    mktemp "$destination_path/.forge-directory-object.XXXXXX"
  )" || fail "$EXIT_REMOTE" "cannot allocate remote object staging file"
  active_remote_digest="$(
    mktemp "$destination_path/.forge-directory-digest.XXXXXX"
  )" || fail "$EXIT_REMOTE" "cannot allocate remote digest staging file"

  cp --reflink=never -- "$source_path" "$active_remote_object" ||
    fail "$EXIT_REMOTE" "cannot stage remote object"
  staged_sha256="$(calculate_sha256 "$active_remote_object")" ||
    fail "$EXIT_REMOTE" "cannot calculate staged object SHA-256"
  [[ "$staged_sha256" = "$expected_sha256" ]] ||
    fail "$EXIT_USAGE" "source changed while staging upload"
  printf '%s\n' "$expected_sha256" >"$active_remote_digest" ||
    fail "$EXIT_REMOTE" "cannot stage remote digest"

  sync_path "$active_remote_object" "remote object staging file"
  sync_path "$active_remote_digest" "remote digest staging file"
}

inspect_remote_pair() {
  validate_remote_entry "$remote_object_path" "remote object"
  validate_remote_entry "$remote_digest_path" "remote digest sidecar"
}

complete_remote_digest() {
  local actual_sha256=""

  require_current_mount_identity
  actual_sha256="$(calculate_sha256 "$remote_object_path")" ||
    fail "$EXIT_REMOTE" "cannot calculate remote object SHA-256"
  [[ "$actual_sha256" = "$expected_sha256" ]] ||
    fail "$EXIT_CONFLICT" \
      "remote object exists with different content"

  if ! ln -- "$active_remote_digest" "$remote_digest_path" 2>/dev/null; then
    return 1
  fi
  sync_path "$remote_digest_path" "remote digest sidecar"
  sync_path "$destination_path" "destination directory"
}

upload_object() {
  local stored_sha256=""
  local actual_sha256=""
  local attempt=0

  require_current_mount_identity
  stage_remote_pair

  while ((attempt < 8)); do
    attempt=$((attempt + 1))
    require_current_mount_identity
    inspect_remote_pair

    if [[ -f "$remote_object_path" && -f "$remote_digest_path" ]]; then
      stored_sha256="$(read_exact_sha256 "$remote_digest_path")" ||
        fail "$EXIT_CONFLICT" "remote digest sidecar is corrupt"
      actual_sha256="$(calculate_sha256 "$remote_object_path")" ||
        fail "$EXIT_REMOTE" "cannot calculate remote object SHA-256"
      [[ "$stored_sha256" = "$actual_sha256" ]] ||
        fail "$EXIT_CONFLICT" \
          "remote object does not match its digest sidecar"
      [[ "$stored_sha256" = "$expected_sha256" ]] ||
        fail "$EXIT_CONFLICT" \
          "remote object exists with a different SHA-256"
      return 0
    fi

    if [[ -f "$remote_digest_path" ]]; then
      fail "$EXIT_CONFLICT" \
        "remote digest sidecar exists without its object"
    fi

    if [[ -f "$remote_object_path" ]]; then
      complete_remote_digest || continue
      continue
    fi

    if ! ln -- "$active_remote_object" "$remote_object_path" 2>/dev/null; then
      continue
    fi
    sync_path "$remote_object_path" "remote object"
    sync_path "$destination_path" "destination directory"
    complete_remote_digest || continue
  done

  fail "$EXIT_REMOTE" "remote upload remained ambiguous after concurrent changes"
}

require_verified_remote_pair() {
  local stored_sha256=""
  local actual_sha256=""

  inspect_remote_pair
  [[ -f "$remote_object_path" && -f "$remote_digest_path" ]] ||
    fail "$EXIT_REMOTE" "remote object or digest sidecar is missing"
  stored_sha256="$(read_exact_sha256 "$remote_digest_path")" ||
    fail "$EXIT_REMOTE" "remote digest sidecar is corrupt"
  actual_sha256="$(calculate_sha256 "$remote_object_path")" ||
    fail "$EXIT_REMOTE" "cannot calculate remote object SHA-256"
  [[ "$actual_sha256" = "$stored_sha256" ]] ||
    fail "$EXIT_REMOTE" "remote object does not match its digest sidecar"
  printf '%s' "$stored_sha256"
}

verify_object() {
  local stored_sha256=""

  require_current_mount_identity
  stored_sha256="$(require_verified_remote_pair)"
  printf '%s\n' "$stored_sha256"
}

require_matching_download_object() {
  local path="$1"
  local expected="$2"
  local actual=""

  [[ -e "$path" || -L "$path" ]] ||
    fail "$EXIT_REMOTE" "download output is missing"
  [[ ! -L "$path" && -f "$path" ]] ||
    fail "$EXIT_CONFLICT" "download output must be a non-symlink regular file"
  actual="$(calculate_sha256 "$path")" ||
    fail "$EXIT_REMOTE" "cannot calculate existing download output SHA-256"
  [[ "$actual" = "$expected" ]] ||
    fail "$EXIT_CONFLICT" "existing download output has different content"
}

require_matching_download_digest() {
  local path="$1"
  local expected="$2"
  local actual=""

  [[ -e "$path" || -L "$path" ]] ||
    fail "$EXIT_REMOTE" "download digest output is missing"
  [[ ! -L "$path" && -f "$path" ]] ||
    fail "$EXIT_CONFLICT" "download digest output must be a non-symlink regular file"
  actual="$(read_exact_sha256 "$path")" ||
    fail "$EXIT_CONFLICT" "existing download digest output is corrupt"
  [[ "$actual" = "$expected" ]] ||
    fail "$EXIT_CONFLICT" "existing download digest output has different SHA-256"
}

publish_download_object() {
  local expected="$1"

  if [[ -e "$output_path" || -L "$output_path" ]]; then
    require_matching_download_object "$output_path" "$expected"
    return 0
  fi
  if ln -- "$active_download_object" "$output_path" 2>/dev/null; then
    rollback_output="$output_path"
    return 0
  fi
  [[ -e "$output_path" || -L "$output_path" ]] ||
    fail "$EXIT_REMOTE" "cannot publish downloaded object"
  require_matching_download_object "$output_path" "$expected"
}

publish_download_digest() {
  local expected="$1"

  if [[ -e "$sha256_output_path" || -L "$sha256_output_path" ]]; then
    require_matching_download_digest "$sha256_output_path" "$expected"
    return 0
  fi
  if ln -- "$active_download_digest" "$sha256_output_path" 2>/dev/null; then
    rollback_digest_output="$sha256_output_path"
    return 0
  fi
  [[ -e "$sha256_output_path" || -L "$sha256_output_path" ]] ||
    fail "$EXIT_REMOTE" "cannot publish downloaded digest"
  require_matching_download_digest "$sha256_output_path" "$expected"
}

download_object() {
  local remote_sha256=""
  local downloaded_sha256=""
  local downloaded_digest=""
  local output_parent=""
  local digest_parent=""

  validate_output_path "$output_path" "output"
  validate_output_path "$sha256_output_path" "sha256 output"
  [[ "$output_path" != "$sha256_output_path" ]] ||
    fail "$EXIT_USAGE" "output and sha256 output must be different paths"

  require_current_mount_identity
  remote_sha256="$(require_verified_remote_pair)"
  output_parent="${output_path%/*}"
  [[ -n "$output_parent" ]] || output_parent="/"
  digest_parent="${sha256_output_path%/*}"
  [[ -n "$digest_parent" ]] || digest_parent="/"

  active_download_object="$(
    mktemp "$output_parent/.forge-directory-download-object.XXXXXX"
  )" || fail "$EXIT_REMOTE" "cannot allocate download staging file"
  active_download_digest="$(
    mktemp "$digest_parent/.forge-directory-download-digest.XXXXXX"
  )" || fail "$EXIT_REMOTE" "cannot allocate digest download staging file"

  require_current_mount_identity
  cp --reflink=never -- "$remote_object_path" "$active_download_object" ||
    fail "$EXIT_REMOTE" "cannot download remote object"
  cp --reflink=never -- "$remote_digest_path" "$active_download_digest" ||
    fail "$EXIT_REMOTE" "cannot download remote digest sidecar"
  downloaded_sha256="$(calculate_sha256 "$active_download_object")" ||
    fail "$EXIT_REMOTE" "cannot calculate downloaded object SHA-256"
  downloaded_digest="$(read_exact_sha256 "$active_download_digest")" ||
    fail "$EXIT_REMOTE" "downloaded digest sidecar is corrupt"
  [[ "$downloaded_sha256" = "$downloaded_digest" &&
    "$downloaded_digest" = "$remote_sha256" ]] ||
    fail "$EXIT_REMOTE" "downloaded object or digest changed during transfer"

  sync_path "$active_download_object" "downloaded object staging file"
  sync_path "$active_download_digest" "downloaded digest staging file"

  publish_download_object "$remote_sha256"
  publish_download_digest "$remote_sha256"
  require_matching_download_object "$output_path" "$remote_sha256"
  require_matching_download_digest "$sha256_output_path" "$remote_sha256"

  sync_path "$output_path" "downloaded object"
  sync_path "$sha256_output_path" "downloaded digest"
  sync_path "$output_parent" "download output directory"
  if [[ "$digest_parent" != "$output_parent" ]]; then
    sync_path "$digest_parent" "digest output directory"
  fi

  rollback_output=""
  rollback_digest_output=""
  rm -f -- "$active_download_object" "$active_download_digest"
  active_download_object=""
  active_download_digest=""
  sync_path "$output_parent" "download output directory"
  if [[ "$digest_parent" != "$output_parent" ]]; then
    sync_path "$digest_parent" "digest output directory"
  fi
}

parse_arguments "$@"

for required_command in cp findmnt ln mktemp realpath rm sha256sum stat sync; do
  command -v "$required_command" >/dev/null 2>&1 ||
    fail "$EXIT_REMOTE" "required command is unavailable: $required_command"
done

validate_destination_and_object
load_mount_identity

case "$operation" in
  upload) upload_object ;;
  verify) verify_object ;;
  download) download_object ;;
esac
