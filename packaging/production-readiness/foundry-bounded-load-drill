        "collector_schema_version": "foundry.production_readiness.bounded_load_drill.v1",
        "binary_sha256": binary_sha256,
        "canary_workflow_id": canary_workflow_id,
    },
}
encoded = json.dumps(report, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"
secret_patterns = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\b(?:ghp|github_pat|sk-proj)-[A-Za-z0-9_-]{12,}\b",
    r"\b[0-9]{8,10}:[A-Za-z0-9_-]{30,}\b",
]
if any(re.search(pattern, encoded) for pattern in secret_patterns):
    raise SystemExit("generated report contains secret-like material")
with open(output, "x", encoding="utf-8") as handle:
    handle.write(encoded)
os.chmod(output, 0o600)
PY

[[ -s "$stage_report" && ! -L "$stage_report" ]] ||
  fail "bounded-load source report was not generated safely"
ln -- "$stage_report" "$report_path" ||
  fail "could not publish bounded-load report without overwriting"
rm -f -- "$stage_report"
rm -rf -- "$stage_dir"
stage_dir=""
printf 'foundry bounded-load drill: passed (%s, sha256=%s)\n' \
