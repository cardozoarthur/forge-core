#!/usr/bin/env bash
# Produce real, secret-free source evidence for the upgrade_rollback gate.
set -euo pipefail
set -o noclobber
umask 077
export LC_ALL=C

fail() {
  printf 'foundry upgrade/rollback drill: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  foundry-upgrade-rollback-drill \
    --candidate /absolute/path/to/candidate/foundry \
    --previous /absolute/path/to/previous/foundry \
    --store /absolute/path/to/pre-upgrade/foundry.sqlite \
    --release-version X.Y.Z \
    --canary-workflow-id wf_ID \
    --output-dir /absolute/private/evidence-root \
    [--max-duration-seconds 120] \
    [--ops-port 18768]

The source store is opened read-only and copied with the SQLite backup API.
Upgrade, rollback, target reinstall, Ops probes, and store/schema checks operate
only on a disposable copy. The source path must contain a store compatible with
the previous binary and the named canary workflow.

The output directory must already exist, be private, and be owned by the
invoking user. upgrade-rollback-report.json must not already exist.

Configure the production vault key out of band through
FOUNDRY_SECRET_VAULT_KEY_FILE. Inline vault-key values are rejected.
EOF
}

require_value() {
  local option="$1"
  local value="${2-}"
  [[ -n "$value" ]] || fail "$option requires a non-empty value"
}

require_single_line() {
  local label="$1"
  local value="$2"
  [[ ! "$value" =~ [[:cntrl:]] ]] ||
    fail "$label must not contain control characters"
}

parse_uint() {
  local value="$1"
  local label="$2"
  local destination="$3"
  local normalized=""

  [[ "$value" =~ ^[0-9]+$ ]] || fail "$label must be a non-negative integer"
  [[ ${#value} -le 18 ]] || fail "$label is outside the supported integer range"
  normalized="$((10#$value))"
  printf -v "$destination" '%s' "$normalized"
}

audit_executable() {
  local candidate="$1"
  local label="$2"
  local audit_root="$3"
  local expected_uid="$4"
  local canonical=""
  local component=""
  local mode=""

  canonical="$(realpath -e -- "$candidate")" ||
    fail "cannot resolve $label: $candidate"
  [[ "$candidate" = "$canonical" ]] ||
    fail "$label path must be canonical and contain no symlink"
  [[ -f "$canonical" && ! -L "$canonical" && -x "$canonical" ]] ||
    fail "$label must be an executable non-symlink regular file"
  if [[ "$audit_root" != "/" ]]; then
    [[ "$canonical" = "$audit_root/"* ]] ||
      fail "$label is outside the test trust root"
  fi

  component="$canonical"
  while true; do
    [[ ! -L "$component" ]] || fail "$label path component is a symlink: $component"
    [[ "$(stat -c '%u' -- "$component")" -eq "$expected_uid" ]] ||
      fail "$label path component has an untrusted owner: $component"
    mode="$(stat -c '%a' -- "$component")"
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] ||
      fail "cannot validate $label permissions: $component"
    (( (8#$mode & 0022) == 0 )) ||
      fail "$label path component is writable by group or other: $component"
    [[ "$component" = "$audit_root" ]] && break
    component="${component%/*}"
    [[ -n "$component" ]] || component="/"
  done
}

for required_command in \
  awk chmod cp curl date env kill ln mkdir mktemp openssl \
  python3 realpath rm seq sha256sum sleep stat timeout tr; do
  command -v "$required_command" >/dev/null 2>&1 ||
    fail "required command not found: $required_command"
done
timeout --version >/dev/null 2>&1 || fail "GNU timeout is required"

test_mode="${FOUNDRY_PRODUCTION_READINESS_TEST_MODE:-0}"
case "$test_mode" in
  0 | 1) ;;
  *) fail "FOUNDRY_PRODUCTION_READINESS_TEST_MODE must be 0 or 1" ;;
esac
production_mode_raw=0
if [[ -v FOUNDRY_PRODUCTION_MODE ]]; then
  production_mode_raw="$FOUNDRY_PRODUCTION_MODE"
fi
production_mode_value="${production_mode_raw,,}"
case "$production_mode_value" in
  0 | false | no | off) production_mode=0 ;;
  1 | true | yes | on) production_mode=1 ;;
  *)
    fail "FOUNDRY_PRODUCTION_MODE must be one of 0,false,no,off,1,true,yes,on"
    ;;
esac
execution_mode="production"
[[ "$test_mode" = 0 ]] || execution_mode="test"

trust_root="/"
trusted_uid=0
if [[ "$test_mode" = 1 ]]; then
  [[ "$production_mode" = 0 ]] ||
    fail "test mode is forbidden when FOUNDRY_PRODUCTION_MODE is enabled"
  test_root="${FOUNDRY_PRODUCTION_READINESS_TEST_ROOT:-}"
  [[ "$test_root" = /* && "$test_root" != "/" && -d "$test_root" && ! -L "$test_root" ]] ||
    fail "FOUNDRY_PRODUCTION_READINESS_TEST_ROOT must be an absolute non-symlink directory"
  marker="$test_root/.foundry-production-readiness-test-root"
  [[ -f "$marker" && ! -L "$marker" ]] ||
    fail "production-readiness test sentinel is missing"
  [[ "$(<"$marker")" = "foundry-production-readiness-test-v1" ]] ||
    fail "production-readiness test sentinel is invalid"
  trust_root="$(realpath -e -- "$test_root")"
  trusted_uid="$(stat -c '%u' -- "$trust_root")"
else
  [[ -z "${FOUNDRY_PRODUCTION_READINESS_TEST_ROOT:-}" ]] ||
    fail "FOUNDRY_PRODUCTION_READINESS_TEST_ROOT requires test mode"
fi
readonly test_mode production_mode execution_mode trust_root trusted_uid

candidate_binary=""
previous_binary=""
source_store_input=""
release_version=""
canary_workflow_id=""
output_dir_input=""
max_duration_input="120"
ops_port_input="18768"

while (($# > 0)); do
  case "$1" in
    --candidate)
      require_value "$1" "${2-}"
      [[ -z "$candidate_binary" ]] || fail "--candidate may only be specified once"
      candidate_binary="$2"
      shift 2
      ;;
    --previous)
      require_value "$1" "${2-}"
      [[ -z "$previous_binary" ]] || fail "--previous may only be specified once"
      previous_binary="$2"
      shift 2
      ;;
    --store)
      require_value "$1" "${2-}"
      [[ -z "$source_store_input" ]] || fail "--store may only be specified once"
      source_store_input="$2"
      shift 2
      ;;
    --release-version)
      require_value "$1" "${2-}"
      [[ -z "$release_version" ]] || fail "--release-version may only be specified once"
      release_version="$2"
      shift 2
      ;;
    --canary-workflow-id)
      require_value "$1" "${2-}"
      [[ -z "$canary_workflow_id" ]] ||
        fail "--canary-workflow-id may only be specified once"
      canary_workflow_id="$2"
      shift 2
      ;;
    --output-dir)
      require_value "$1" "${2-}"
      [[ -z "$output_dir_input" ]] || fail "--output-dir may only be specified once"
      output_dir_input="$2"
      shift 2
      ;;
    --max-duration-seconds)
      require_value "$1" "${2-}"
      max_duration_input="$2"
      shift 2
      ;;
    --ops-port)
      require_value "$1" "${2-}"
      ops_port_input="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      fail "unexpected positional argument: $1"
      ;;
  esac
done

[[ -n "$candidate_binary" ]] || fail "--candidate is required"
[[ -n "$previous_binary" ]] || fail "--previous is required"
[[ -n "$source_store_input" ]] || fail "--store is required"
[[ -n "$release_version" ]] || fail "--release-version is required"
[[ -n "$canary_workflow_id" ]] || fail "--canary-workflow-id is required"
[[ -n "$output_dir_input" ]] || fail "--output-dir is required"

for path_value in \
  "$candidate_binary" "$previous_binary" "$source_store_input" "$output_dir_input"; do
  require_single_line "path" "$path_value"
done
require_single_line "release version" "$release_version"
require_single_line "canary workflow id" "$canary_workflow_id"

[[ "$release_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] ||
  fail "--release-version must be a semantic version without a v prefix"
[[ "$canary_workflow_id" =~ ^wf_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]] ||
  fail "--canary-workflow-id must be a bounded wf_ identifier"

max_duration_seconds=0
ops_port=0
parse_uint "$max_duration_input" "--max-duration-seconds" max_duration_seconds
parse_uint "$ops_port_input" "--ops-port" ops_port
((max_duration_seconds >= 1 && max_duration_seconds <= 300)) ||
  fail "--max-duration-seconds must be between 1 and 300"
((ops_port >= 1024 && ops_port <= 65535)) ||
  fail "--ops-port must be between 1024 and 65535"

[[ "$candidate_binary" = /* ]] || fail "--candidate must be an absolute path"
[[ "$previous_binary" = /* ]] || fail "--previous must be an absolute path"
audit_executable "$candidate_binary" "candidate Foundry executable" "$trust_root" "$trusted_uid"
audit_executable "$previous_binary" "previous Foundry executable" "$trust_root" "$trusted_uid"
[[ "$candidate_binary" != "$previous_binary" ]] ||
  fail "candidate and previous Foundry paths must differ"

candidate_version="$("$candidate_binary" --version 2>/dev/null)" ||
  fail "candidate Foundry executable did not report a version"
previous_version="$("$previous_binary" --version 2>/dev/null)" ||
  fail "previous Foundry executable did not report a version"
[[ "$candidate_version" = "foundry $release_version" ]] ||
  fail "candidate Foundry version does not match --release-version"
[[ "$previous_version" =~ ^foundry\ ([0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?)$ ]] ||
  fail "previous Foundry executable reported an unsupported version"
previous_version="${BASH_REMATCH[1]}"
[[ "$previous_version" != "$release_version" ]] ||
  fail "previous Foundry version must differ from the candidate release"
python3 - "$previous_version" "$release_version" <<'PY'
import sys

def base_version(value):
    base = value.split("+", 1)[0].split("-", 1)[0]
    parts = base.split(".")
    if len(parts) != 3 or any(not part.isdigit() for part in parts):
        raise SystemExit("invalid base semantic version")
    return tuple(int(part) for part in parts)

if not base_version(sys.argv[1]) < base_version(sys.argv[2]):
    raise SystemExit("previous base semantic version is not older than candidate")
PY
candidate_binary_sha256="$(sha256sum "$candidate_binary" | awk '{print $1}')"
previous_binary_sha256="$(sha256sum "$previous_binary" | awk '{print $1}')"
[[ "$candidate_binary_sha256" =~ ^[0-9a-f]{64}$ &&
  "$previous_binary_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "candidate or previous Foundry executable digest is invalid"
[[ "$candidate_binary_sha256" != "$previous_binary_sha256" ]] ||
  fail "candidate and previous Foundry executable bytes must differ"

[[ "$source_store_input" = /* ]] || fail "--store must be an absolute path"
[[ -f "$source_store_input" && ! -L "$source_store_input" ]] ||
  fail "--store must identify a non-symlink regular file"
source_store="$(realpath -e -- "$source_store_input")"
[[ "$source_store" = "$source_store_input" ]] ||
  fail "--store path must be canonical and contain no symlink"
store_mode="$(stat -c '%a' -- "$source_store")"
[[ "$store_mode" =~ ^[0-7]{3,4}$ ]] ||
  fail "cannot validate source store permissions"
(( (8#$store_mode & 0077) == 0 )) ||
  fail "source store must not be accessible by group or other"

[[ "$output_dir_input" = /* && "$output_dir_input" != "/" ]] ||
  fail "--output-dir must be an absolute directory other than /"
[[ -d "$output_dir_input" && ! -L "$output_dir_input" ]] ||
  fail "--output-dir must be an existing non-symlink directory"
output_dir="$(realpath -e -- "$output_dir_input")"
[[ "$output_dir" = "$output_dir_input" ]] ||
  fail "--output-dir path must be canonical and contain no symlink"
[[ "$(stat -c '%u' -- "$output_dir")" -eq "$EUID" ]] ||
  fail "--output-dir must be owned by the invoking user"
output_mode="$(stat -c '%a' -- "$output_dir")"
[[ "$output_mode" =~ ^[0-7]{3,4}$ ]] ||
  fail "cannot validate --output-dir permissions"
(( (8#$output_mode & 0077) == 0 )) ||
  fail "--output-dir must be private to the invoking user"
[[ -w "$output_dir" ]] || fail "--output-dir must be writable"

report_path="$output_dir/upgrade-rollback-report.json"
[[ ! -e "$report_path" && ! -L "$report_path" ]] ||
  fail "output must be new: $report_path"

[[ -z "${FOUNDRY_SECRET_VAULT_KEY+x}" ]] ||
  fail "FOUNDRY_SECRET_VAULT_KEY is forbidden; use a key file"
[[ -z "${FOUNDRY_SECRET_VAULT_PREVIOUS_KEYS+x}" ]] ||
  fail "FOUNDRY_SECRET_VAULT_PREVIOUS_KEYS is forbidden; use key files"
vault_key_file="${FOUNDRY_SECRET_VAULT_KEY_FILE:-}"
[[ "$vault_key_file" = /* && -f "$vault_key_file" && ! -L "$vault_key_file" && -r "$vault_key_file" ]] ||
  fail "FOUNDRY_SECRET_VAULT_KEY_FILE must identify a readable absolute non-symlink file"

work_dir="$(mktemp -d /tmp/foundry-upgrade-rollback.XXXXXX)"
chmod 0700 "$work_dir"
printf '%s\n' "foundry-upgrade-rollback-work-v1" >"$work_dir/.sentinel"
stage_dir=""
stage_report=""
server_pid=""

cleanup() {
  if [[ "$server_pid" =~ ^[0-9]+$ ]] && kill -0 "$server_pid" 2>/dev/null; then
    kill -TERM "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  if [[ -n "${stage_dir:-}" && "$stage_dir" = "$output_dir"/.upgrade-rollback-stage.* &&
    -d "$stage_dir" && ! -L "$stage_dir" ]]; then
    rm -rf -- "$stage_dir"
  fi
  if [[ "$work_dir" = /tmp/foundry-upgrade-rollback.* &&
    -f "$work_dir/.sentinel" &&
    "$(<"$work_dir/.sentinel")" = "foundry-upgrade-rollback-work-v1" ]]; then
    rm -rf -- "$work_dir"
  fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

stage_dir="$(mktemp -d "$output_dir/.upgrade-rollback-stage.XXXXXX")"
chmod 0700 "$stage_dir"
stage_report="$stage_dir/upgrade-rollback-report.json"

vault_env=(
  env
  -u CREDENTIALS_DIRECTORY
  -u FOUNDRY_BACKUP_OFFHOST_COMMAND_FILE
  -u FOUNDRY_BACKUP_OFFHOST_DESTINATION_FILE
  -u FOUNDRY_BACKUP_OFFHOST_GENERATION_FILE
  -u FOUNDRY_OPS_BEARER_TOKEN
  FOUNDRY_PRODUCTION_MODE=1
  "FOUNDRY_SECRET_VAULT_KEY_FILE=$vault_key_file"
)

run_foundry() {
  local binary="$1"
  local label="$2"
  shift 2
  if timeout --foreground --signal=TERM --kill-after=2s "${max_duration_seconds}s" \
    "${vault_env[@]}" "$binary" "$@"; then
    return 0
  fi
  fail "$label failed or exceeded the bounded timeout"
}

schema_sha256() {
  python3 - "$1" <<'PY'
import hashlib
import json
import sqlite3
import sys

connection = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
try:
    check = connection.execute("PRAGMA quick_check").fetchone()
    if check != ("ok",):
        raise SystemExit("store quick_check failed")
    rows = connection.execute(
        """
        SELECT type, name, tbl_name, COALESCE(sql, '')
        FROM sqlite_schema
        WHERE name NOT LIKE 'sqlite_%'
        ORDER BY type, name, tbl_name, sql
        """
    ).fetchall()
finally:
    connection.close()
if not rows:
    raise SystemExit("store schema is empty")
encoded = json.dumps(rows, ensure_ascii=False, separators=(",", ":")).encode()
print(hashlib.sha256(encoded).hexdigest())
PY
}

baseline_store="$work_dir/pre-upgrade-backup.sqlite"
working_store="$work_dir/upgrade-store.sqlite"
python3 - "$source_store" "$baseline_store" <<'PY'
import os
import sqlite3
import sys

source_path, backup_path = sys.argv[1:]
source = sqlite3.connect(f"file:{source_path}?mode=ro", uri=True)
try:
    result = source.execute("PRAGMA quick_check").fetchone()
    if result != ("ok",):
        raise SystemExit("source store quick_check failed")
    destination = sqlite3.connect(backup_path)
    try:
        source.backup(destination)
        destination.commit()
        copied = destination.execute("PRAGMA quick_check").fetchone()
        if copied != ("ok",):
            raise SystemExit("pre-upgrade backup quick_check failed")
    finally:
        destination.close()
finally:
    source.close()
os.chmod(backup_path, 0o600)
PY
[[ -s "$baseline_store" && ! -L "$baseline_store" ]] ||
  fail "SQLite did not create a safe non-empty pre-upgrade backup"
baseline_sha256="$(sha256sum "$baseline_store" | awk '{print $1}')"
[[ "$baseline_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "pre-upgrade backup digest is invalid"
cp --reflink=auto --no-clobber -- "$baseline_store" "$working_store"
chmod 0600 "$working_store"

ops_token_file="$work_dir/ops-token"
curl_config="$work_dir/curl.conf"
openssl rand -hex 32 >"$ops_token_file"
ops_token="$(tr -d '\r\n' <"$ops_token_file")"
printf 'header = "Authorization: Bearer %s"\n' "$ops_token" >"$curl_config"
unset ops_token
chmod 0600 "$ops_token_file" "$curl_config"

start_and_probe_ops() {
  local binary="$1"
  local label="$2"
  local index="$3"
  local http_status=""
  local _attempt=""

  "${vault_env[@]}" \
    "FOUNDRY_OPS_BEARER_TOKEN_FILE=$ops_token_file" \
    "$binary" \
    --store "$working_store" \
    ops serve \
    --project-root "$work_dir/workspace" \
    --host 127.0.0.1 \
    --port "$ops_port" \
    >"$work_dir/ops-$index.log" 2>&1 &
  server_pid="$!"
  sleep 0.05

  for _attempt in $(seq 1 100); do
    http_status="$(
      curl --disable --config "$curl_config" \
        --silent --output /dev/null --write-out '%{http_code}' \
        --max-time 2 \
        "http://127.0.0.1:$ops_port/api/snapshot" 2>/dev/null ||
        true
    )"
    if [[ "$http_status" = 200 ]]; then
      kill -TERM "$server_pid" 2>/dev/null ||
        fail "could not stop $label Ops after its health probe"
      wait "$server_pid" ||
        fail "$label Ops did not stop cleanly"
      server_pid=""
      return 0
    fi
    kill -0 "$server_pid" 2>/dev/null ||
      fail "$label Ops exited before becoming ready"
    sleep 0.05
  done
  fail "$label Ops did not become ready on loopback"
}

run_foundry "$previous_binary" "previous-version store check" \
  --store "$working_store" store check --output json >"$work_dir/previous-check.json"
run_foundry "$previous_binary" "previous-version canary inspection" \
  --store "$working_store" inspect "$canary_workflow_id" --output json \
  >"$work_dir/previous-canary.json"
baseline_schema="$(schema_sha256 "$working_store")" ||
  fail "could not fingerprint the previous-version schema"
start_and_probe_ops "$previous_binary" "previous-version baseline" previous-baseline

run_foundry "$candidate_binary" "candidate upgraded store check" \
  --store "$working_store" store check --output json >"$work_dir/upgraded-check.json"
run_foundry "$candidate_binary" "candidate upgraded canary inspection" \
  --store "$working_store" inspect "$canary_workflow_id" --output json \
  >"$work_dir/upgraded-canary.json"
start_and_probe_ops "$candidate_binary" "candidate upgraded" candidate-upgraded
upgraded_schema="$(schema_sha256 "$working_store")" ||
  fail "could not fingerprint the upgraded schema"

run_foundry "$previous_binary" "rollback restore" \
  --store "$working_store" store restore \
  --source "$baseline_store" \
  --approved-by production-readiness-drill \
  --confirm-restore \
  --output json >"$work_dir/rollback.json"
run_foundry "$previous_binary" "previous-version post-rollback store check" \
  --store "$working_store" store check --output json >"$work_dir/rollback-check.json"
run_foundry "$previous_binary" "previous-version post-rollback canary inspection" \
  --store "$working_store" inspect "$canary_workflow_id" --output json \
  >"$work_dir/rollback-canary.json"
rollback_schema="$(schema_sha256 "$working_store")" ||
  fail "could not fingerprint the rolled-back schema"
[[ "$rollback_schema" = "$baseline_schema" ]] ||
  fail "rollback did not restore the previous-version schema"
[[ "$(sha256sum "$baseline_store" | awk '{print $1}')" = "$baseline_sha256" ]] ||
  fail "rollback mutated the pre-upgrade backup"
start_and_probe_ops "$previous_binary" "previous-version rollback" previous-rollback

run_foundry "$candidate_binary" "candidate reinstall store check" \
  --store "$working_store" store check --output json >"$work_dir/reinstall-check.json"
run_foundry "$candidate_binary" "candidate reinstall canary inspection" \
  --store "$working_store" inspect "$canary_workflow_id" --output json \
  >"$work_dir/reinstall-canary.json"
start_and_probe_ops "$candidate_binary" "candidate reinstall" candidate-reinstall
reinstalled_schema="$(schema_sha256 "$working_store")" ||
  fail "could not fingerprint the reinstalled candidate schema"
[[ "$reinstalled_schema" = "$upgraded_schema" ]] ||
  fail "candidate reinstall produced a different schema than the initial upgrade"
[[ "$(sha256sum "$baseline_store" | awk '{print $1}')" = "$baseline_sha256" ]] ||
  fail "candidate reinstall mutated the pre-upgrade backup"

observed_at_epoch="$(date -u +%s)"
python3 - \
  "$stage_report" \
  "$release_version" \
  "$observed_at_epoch" \
  "$execution_mode" \
  "$previous_version" \
  "$candidate_binary_sha256" \
  "$previous_binary_sha256" \
  "$canary_workflow_id" \
  "$baseline_sha256" \
  "$baseline_schema" \
  "$upgraded_schema" \
  "$rollback_schema" \
  "$reinstalled_schema" <<'PY'
import json
import os
import re
import sys

(
    output,
    release,
    observed,
    execution_mode,
    previous_version,
    candidate_binary_sha256,
    previous_binary_sha256,
    canary_workflow_id,
    baseline_backup_sha256,
    baseline_schema_sha256,
    upgraded_schema_sha256,
    rollback_schema_sha256,
    reinstalled_schema_sha256,
) = sys.argv[1:]
report = {
    "schema_version": "foundry.milestone.production_source_evidence.upgrade_rollback.v1",
    "kind": "upgrade_rollback",
    "status": "passed",
    "subject_version": release,
    "observed_at_epoch": int(observed),
    "execution_mode": execution_mode,
    "producer": "foundry-upgrade-rollback-drill",
    "claims": {
        "target_version": release,
        "simulation_completed": True,
        "pre_upgrade_backup_verified": True,
        "upgraded_store_check_passed": True,
        "upgraded_ops_health_passed": True,
        "rollback_completed": True,
        "previous_version_store_check_passed": True,
        "previous_version_ops_health_passed": True,
        "target_reinstalled_and_healthy": True,
    },
    "evidence": {
        "collector_schema_version": "foundry.production_readiness.upgrade_rollback_drill.v1",
        "previous_version": previous_version,
        "candidate_binary_sha256": candidate_binary_sha256,
        "previous_binary_sha256": previous_binary_sha256,
        "canary_workflow_id": canary_workflow_id,
        "baseline_backup_sha256": baseline_backup_sha256,
        "baseline_schema_sha256": baseline_schema_sha256,
        "upgraded_schema_sha256": upgraded_schema_sha256,
        "rollback_schema_sha256": rollback_schema_sha256,
        "reinstalled_schema_sha256": reinstalled_schema_sha256,
    },
}
encoded = json.dumps(report, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"
secret_patterns = [
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
    r"\bAKIA[0-9A-Z]{16}\b",
    r"\b(?:ghp|github_pat|sk-proj)-[A-Za-z0-9_-]{12,}\b",
    r"\b[0-9]{8,10}:[A-Za-z0-9_-]{30,}\b",
]
if any(re.search(pattern, encoded) for pattern in secret_patterns):
