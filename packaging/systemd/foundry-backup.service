[Unit]
Description=Back up, verify, and replicate the Foundry Core store off-host
Documentation=https://github.com/cardozoarthur/foundry-core/blob/main/docs/production-single-host.md
ConditionPathExists=/var/lib/foundry/foundry.sqlite
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=foundry
Group=foundry
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/local/libexec/foundry-backup
LoadCredential=foundry-backup-offhost-command:/etc/foundry/backup-offhost-command
LoadCredential=foundry-backup-offhost-destination:/etc/foundry/backup-offhost-destination
LoadCredential=foundry-backup-offhost-generation:/etc/foundry/backup-offhost-generation
Environment=FOUNDRY_PRODUCTION_MODE=1
Environment=FOUNDRY_BACKUP_OFFHOST_COMMAND_FILE=/run/credentials/foundry-backup.service/foundry-backup-offhost-command
Environment=FOUNDRY_BACKUP_OFFHOST_DESTINATION_FILE=/run/credentials/foundry-backup.service/foundry-backup-offhost-destination
Environment=FOUNDRY_BACKUP_OFFHOST_GENERATION_FILE=/run/credentials/foundry-backup.service/foundry-backup-offhost-generation

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadOnlyPaths=/var/lib/foundry
ReadWritePaths=/var/backups/foundry
