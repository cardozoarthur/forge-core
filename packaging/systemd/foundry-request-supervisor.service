[Unit]
Description=Foundry Core asynchronous request supervisor
Documentation=https://github.com/cardozoarthur/foundry-core/blob/main/docs/production-single-host.md
After=network-online.target foundry-ops.service foundry-runtime.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/var/lib/foundry/foundry.sqlite

[Service]
Type=simple
User=foundry
Group=foundry
UMask=0077
StateDirectory=foundry
StateDirectoryMode=0700
ConfigurationDirectory=foundry
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/foundry/workspace
ExecStartPre=/usr/bin/mkdir -p /var/lib/foundry/workspace
ExecStart=/usr/local/bin/foundry --store /var/lib/foundry/foundry.sqlite request supervise --executor foundry-request-supervisor --origin foundry-request-supervisor --ttl-seconds 300 --max-steps-per-run 1 --continuous --max-cycles 0 --interval-seconds 30 --output json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
EnvironmentFile=-/etc/foundry/foundry.env
LoadCredential=foundry-secret-key:/etc/foundry/secret.key
Environment=FOUNDRY_PRODUCTION_MODE=1
Environment=FOUNDRY_SECRET_VAULT_KEY_FILE=/run/credentials/foundry-request-supervisor.service/foundry-secret-key

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/foundry
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
