[Unit]
Description=Foundry Core single-host workflow runtime
Documentation=https://github.com/cardozoarthur/foundry-core/blob/main/docs/production-single-host.md
After=network-online.target foundry-ops.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=foundry
Group=foundry
UMask=0077
StateDirectory=foundry
StateDirectoryMode=0700
ConfigurationDirectory=foundry
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/foundry/workspace
ExecStartPre=/usr/bin/mkdir -p /var/lib/foundry/workspace
ExecStart=/usr/local/bin/foundry --store /var/lib/foundry/foundry.sqlite events runtime-daemon --project-root /var/lib/foundry/workspace --execute --dispatch-activations --continuous --cycle-retention 100 --recover-stale-services --lease-owner foundry.systemd.runtime-daemon --lease-seconds 300 --heartbeat-seconds 60 --max-runs 1 --backoff-initial-seconds 5 --backoff-max-seconds 300 --scan-schedules --schedule-executor foundry-runtime-scheduler --schedule-max-workers 1 --schedule-ttl-seconds 300 --interval-seconds 30 --output json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
EnvironmentFile=-/etc/foundry/foundry.env
LoadCredential=foundry-secret-key:/etc/foundry/secret.key
Environment=FOUNDRY_PRODUCTION_MODE=1
Environment=FOUNDRY_SECRET_VAULT_KEY_FILE=/run/credentials/foundry-runtime.service/foundry-secret-key

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/foundry
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
