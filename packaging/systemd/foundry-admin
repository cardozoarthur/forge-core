#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -eq 0 ]] || {
  echo "foundry-admin: run through sudo or as root" >&2
  exit 1
}
[[ $# -gt 0 ]] || {
  echo "foundry-admin: usage: foundry-admin <foundry arguments...>" >&2
  exit 1
}

# Expansion belongs to the transient /bin/sh, not this wrapper.
# shellcheck disable=SC2016
exec systemd-run \
  --quiet \
  --wait \
  --pipe \
  --collect \
  --unit="foundry-admin-$$" \
  --property=User=foundry \
  --property=Group=foundry \
  --property=UMask=0077 \
  --property=LoadCredential=foundry-secret-key:/etc/foundry/secret.key \
  --property=NoNewPrivileges=yes \
  --property=PrivateTmp=yes \
  --property=ProtectHome=yes \
  --property=ProtectSystem=strict \
  --property="ReadWritePaths=/var/lib/foundry -/var/backups/foundry" \
  --setenv=FOUNDRY_PRODUCTION_MODE=1 \
  /bin/sh -c '
    export FOUNDRY_SECRET_VAULT_KEY_FILE="$CREDENTIALS_DIRECTORY/foundry-secret-key"
    exec /usr/local/bin/foundry "$@"
  ' foundry-admin "$@"
