[Unit]
Description=Foundry Core single-host operations service
Documentation=https://github.com/cardozoarthur/foundry-core/blob/main/docs/production-single-host.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=foundry
Group=foundry
UMask=0077
StateDirectory=foundry
StateDirectoryMode=0700
RuntimeDirectory=foundry
RuntimeDirectoryMode=0700
ConfigurationDirectory=foundry
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/foundry
ExecStartPre=/usr/bin/mkdir -p /var/lib/foundry/workspace
ExecStart=/usr/local/bin/foundry --store /var/lib/foundry/foundry.sqlite ops serve --project-root /var/lib/foundry/workspace --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
EnvironmentFile=-/etc/foundry/foundry.env
LoadCredential=foundry-secret-key:/etc/foundry/secret.key
LoadCredential=foundry-ops-token:/etc/foundry/ops-token
Environment=FOUNDRY_PRODUCTION_MODE=1
Environment=FOUNDRY_SECRET_VAULT_KEY_FILE=/run/credentials/foundry-ops.service/foundry-secret-key
Environment=FOUNDRY_OPS_BEARER_TOKEN_FILE=/run/credentials/foundry-ops.service/foundry-ops-token

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/foundry
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
