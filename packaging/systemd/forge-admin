#!/usr/bin/env bash
set -euo pipefail

[[ "$EUID" -eq 0 ]] || {
  echo "forge-admin: run through sudo or as root" >&2
  exit 1
}
[[ $# -gt 0 ]] || {
  echo "forge-admin: usage: forge-admin <forge arguments...>" >&2
  exit 1
}

# Expansion belongs to the transient /bin/sh, not this wrapper.
# shellcheck disable=SC2016
exec systemd-run \
  --quiet \
  --wait \
  --pipe \
  --collect \
  --unit="forge-admin-$$" \
  --property=User=forge \
  --property=Group=forge \
  --property=UMask=0077 \
  --property=LoadCredential=forge-secret-key:/etc/forge/secret.key \
  --property=NoNewPrivileges=yes \
  --property=PrivateTmp=yes \
  --property=ProtectHome=yes \
  --property=ProtectSystem=strict \
  --property="ReadWritePaths=/var/lib/forge /var/backups/forge" \
  --setenv=FORGE_PRODUCTION_MODE=1 \
  /bin/sh -c '
    export FORGE_SECRET_VAULT_KEY_FILE="$CREDENTIALS_DIRECTORY/forge-secret-key"
    exec /usr/local/bin/forge "$@"
  ' forge-admin "$@"
