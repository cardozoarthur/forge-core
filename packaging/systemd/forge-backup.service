[Unit]
Description=Back up, verify, and replicate the Forge Core store off-host
Documentation=https://github.com/cardozoarthur/forge-core/blob/main/docs/production-single-host.md
ConditionPathExists=/var/lib/forge/forge.sqlite
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=forge
Group=forge
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/local/libexec/forge-backup
LoadCredential=forge-backup-offhost-command:/etc/forge/backup-offhost-command
LoadCredential=forge-backup-offhost-destination:/etc/forge/backup-offhost-destination
LoadCredential=forge-backup-offhost-generation:/etc/forge/backup-offhost-generation
Environment=FORGE_PRODUCTION_MODE=1
Environment=FORGE_BACKUP_OFFHOST_COMMAND_FILE=/run/credentials/forge-backup.service/forge-backup-offhost-command
Environment=FORGE_BACKUP_OFFHOST_DESTINATION_FILE=/run/credentials/forge-backup.service/forge-backup-offhost-destination
Environment=FORGE_BACKUP_OFFHOST_GENERATION_FILE=/run/credentials/forge-backup.service/forge-backup-offhost-generation

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadOnlyPaths=/var/lib/forge
ReadWritePaths=/var/backups/forge
