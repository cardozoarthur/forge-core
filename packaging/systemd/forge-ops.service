[Unit]
Description=Forge Core single-host operations service
Documentation=https://github.com/cardozoarthur/forge-core/blob/main/docs/production-single-host.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=forge
Group=forge
UMask=0077
StateDirectory=forge
StateDirectoryMode=0700
RuntimeDirectory=forge
RuntimeDirectoryMode=0700
ConfigurationDirectory=forge
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/forge
ExecStartPre=/usr/bin/mkdir -p /var/lib/forge/workspace
ExecStart=/usr/local/bin/forge --store /var/lib/forge/forge.sqlite ops serve --project-root /var/lib/forge/workspace --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
EnvironmentFile=-/etc/forge/forge.env
LoadCredential=forge-secret-key:/etc/forge/secret.key
LoadCredential=forge-ops-token:/etc/forge/ops-token
Environment=FORGE_PRODUCTION_MODE=1
Environment=FORGE_SECRET_VAULT_KEY_FILE=/run/credentials/forge-ops.service/forge-secret-key
Environment=FORGE_OPS_BEARER_TOKEN_FILE=/run/credentials/forge-ops.service/forge-ops-token

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/forge
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
