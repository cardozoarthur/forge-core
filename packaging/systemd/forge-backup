#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() {
  echo "forge backup: $*" >&2
  exit 1
}

production_mode_value="${FORGE_PRODUCTION_MODE:-}"
production_mode_value="${production_mode_value#"${production_mode_value%%[![:space:]]*}"}"
production_mode_value="${production_mode_value%"${production_mode_value##*[![:space:]]}"}"
production_mode_value="${production_mode_value,,}"
case "$production_mode_value" in
  1 | true | yes | on) production_mode_enabled=true ;;
  *) production_mode_enabled=false ;;
esac
readonly production_mode_enabled
readonly test_mode="${FORGE_BACKUP_TEST_MODE:-0}"

case "$test_mode" in
  0 | 1) ;;
  *) fail "FORGE_BACKUP_TEST_MODE must be 0 or 1" ;;
esac

if [[ "$test_mode" = 1 ]]; then
  [[ "$production_mode_enabled" = false ]] ||
    fail "test overrides are forbidden when FORGE_PRODUCTION_MODE is enabled"
  [[ -z "${FORGE_BACKUP_OFFHOST_COMMAND_FILE:-}" &&
    -z "${FORGE_BACKUP_OFFHOST_DESTINATION_FILE:-}" &&
    -z "${FORGE_BACKUP_OFFHOST_GENERATION_FILE:-}" &&
    -z "${FORGE_BACKUP_OFFHOST_MOUNT_IDENTITY_FILE:-}" ]] ||
    fail "test mode derives all configuration paths from FORGE_BACKUP_TEST_ROOT"

  test_root="${FORGE_BACKUP_TEST_ROOT:-}"
  [[ "$test_root" = /* && "$test_root" != "/" &&
    -d "$test_root" && ! -L "$test_root" ]] ||
    fail "FORGE_BACKUP_TEST_ROOT must be an absolute non-symlink directory"

  test_marker="$test_root/.forge-backup-test-root"
  test_marker_lines=()
  [[ -f "$test_marker" && ! -L "$test_marker" ]] ||
    fail "test root sentinel is missing or unsafe: $test_marker"
  mapfile -t test_marker_lines <"$test_marker"
  [[ ${#test_marker_lines[@]} -eq 1 &&
    "${test_marker_lines[0]}" = "forge-backup-smoke-v1" ]] ||
    fail "test root sentinel is invalid: $test_marker"

  for test_directory in bin state backups config; do
    [[ -d "$test_root/$test_directory" &&
      ! -L "$test_root/$test_directory" ]] ||
      fail "test root directory is missing or unsafe: $test_root/$test_directory"
  done

  forge_binary="$test_root/bin/forge"
  store="$test_root/state/forge.sqlite"
  backup_dir="$test_root/backups"
  default_offhost_command_file="$test_root/config/offhost-command"
  default_offhost_destination_file="$test_root/config/offhost-destination"
  default_offhost_generation_file="$test_root/config/offhost-generation"
  default_offhost_mount_identity_file="$test_root/config/offhost-mount-identity"
else
  [[ -z "${FORGE_BACKUP_TEST_ROOT:-}" &&
    -z "${FORGE_BACKUP_TEST_TIMESTAMP:-}" ]] ||
    fail "test-only overrides require FORGE_BACKUP_TEST_MODE=1"

  forge_binary="/usr/local/bin/forge"
  store="/var/lib/forge/forge.sqlite"
  backup_dir="/var/backups/forge"
  default_offhost_command_file="/etc/forge/backup-offhost-command"
  default_offhost_destination_file="/etc/forge/backup-offhost-destination"
  default_offhost_generation_file="/etc/forge/backup-offhost-generation"
  default_offhost_mount_identity_file="/etc/forge/backup-offhost-mount-identity"
fi

readonly forge_binary
readonly store
readonly backup_dir
readonly offhost_command_file="${FORGE_BACKUP_OFFHOST_COMMAND_FILE:-$default_offhost_command_file}"
readonly offhost_destination_file="${FORGE_BACKUP_OFFHOST_DESTINATION_FILE:-$default_offhost_destination_file}"
readonly offhost_generation_file="${FORGE_BACKUP_OFFHOST_GENERATION_FILE:-$default_offhost_generation_file}"
readonly offhost_mount_identity_file="${FORGE_BACKUP_OFFHOST_MOUNT_IDENTITY_FILE:-$default_offhost_mount_identity_file}"
readonly local_retention_days=14

read_single_line_config() {
  local config_path="$1"
  local config_name="$2"
  local -a config_lines=()

  [[ -f "$config_path" && -r "$config_path" ]] ||
    fail "$config_name file is not a readable regular file: $config_path"

  mapfile -t config_lines <"$config_path"
  [[ ${#config_lines[@]} -eq 1 && -n "${config_lines[0]}" ]] ||
    fail "$config_name file must contain exactly one non-empty line: $config_path"

  printf '%s' "${config_lines[0]}"
}

offhost_command="$(read_single_line_config "$offhost_command_file" "off-host command")"
offhost_destination="$(
  read_single_line_config "$offhost_destination_file" "off-host destination"
)"
offhost_generation="$(
  read_single_line_config "$offhost_generation_file" "off-host generation"
)"

validate_file_destination_path() {
  local destination_value="$1"
  local candidate_path=""
  local canonical_path=""

  [[ "$destination_value" == file:///* &&
    "$destination_value" != *$'\n'* &&
    "$destination_value" != *$'\r'* ]] ||
    fail "directory destination must be file:///absolute/path"
  candidate_path="${destination_value#file://}"
  [[ "$candidate_path" =~ ^/[A-Za-z0-9._/@:+,-]+$ &&
    "$candidate_path" != *"//"* &&
    "$candidate_path" != *"/./"* &&
    "$candidate_path" != *"/../"* &&
    "$candidate_path" != */"." &&
    "$candidate_path" != */".." &&
    "$candidate_path" != */ &&
    -d "$candidate_path" &&
    ! -L "$candidate_path" ]] ||
    fail "directory destination must be an existing canonical non-symlink path"
  canonical_path="$(realpath -e -- "$candidate_path")" ||
    fail "cannot resolve directory destination: $candidate_path"
  [[ "$canonical_path" = "$candidate_path" ]] ||
    fail "directory destination must contain no symlink or traversal"

  printf '%s' "$candidate_path"
}

read_mount_field() {
  local destination_path="$1"
  local field="$2"
  local -a field_lines=()

  mapfile -t field_lines < <(
    findmnt \
      --noheadings \
      --raw \
      --first-only \
      --output "$field" \
      --target "$destination_path"
  )
  [[ ${#field_lines[@]} -eq 1 && -n "${field_lines[0]}" ]] ||
    fail "cannot resolve current mount $field for directory destination"
  [[ "${field_lines[0]}" != *$'\r'* ]] ||
    fail "current mount $field contains a carriage return"

  printf '%s' "${field_lines[0]}"
}

load_directory_mount_identity() {
  local identity_path="$1"
  local canonical_identity_path=""
  local -a identity_lines=()

  [[ "$identity_path" = /* &&
    -f "$identity_path" &&
    ! -L "$identity_path" &&
    -r "$identity_path" ]] ||
    fail "directory mount identity must be a readable absolute non-symlink regular file"
  canonical_identity_path="$(realpath -e -- "$identity_path")" ||
    fail "cannot resolve directory mount identity file"
  [[ "$canonical_identity_path" = "$identity_path" ]] ||
    fail "directory mount identity file must contain no symlink or traversal"
  mapfile -t identity_lines <"$identity_path"
  [[ ${#identity_lines[@]} -eq 5 &&
    "${identity_lines[0]}" = "forge-directory-mount-v1" &&
    "${identity_lines[1]}" = target=* &&
    "${identity_lines[2]}" = source=* &&
    "${identity_lines[3]}" = fstype=* &&
    "${identity_lines[4]}" = fsid=* ]] ||
    fail "directory mount identity file has an invalid schema"

  directory_mount_target="${identity_lines[1]#target=}"
  directory_mount_source="${identity_lines[2]#source=}"
  directory_mount_fstype="${identity_lines[3]#fstype=}"
  directory_mount_fsid="${identity_lines[4]#fsid=}"
  [[ "$directory_mount_target" = /* &&
    "$directory_mount_target" != "/" &&
    "$directory_mount_target" =~ ^/[A-Za-z0-9._/@:+,-]+$ &&
    "$directory_mount_target" != *"//"* &&
    "$directory_mount_target" != *"/./"* &&
    "$directory_mount_target" != *"/../"* &&
    "$directory_mount_target" != */"." &&
    "$directory_mount_target" != */".." &&
    "$directory_mount_target" != */ &&
    -n "$directory_mount_source" &&
    "$directory_mount_source" != *$'\r'* &&
    "$directory_mount_fstype" =~ ^[A-Za-z0-9._+-]+$ &&
    "$directory_mount_fsid" =~ ^[0-9A-Fa-f]+$ ]] ||
    fail "directory mount identity contains invalid values"
}

directory_destination_path=""
directory_mount_target=""
directory_mount_source=""
directory_mount_fstype=""
directory_mount_fsid=""
if [[ "$offhost_destination" == file://* ]]; then
  directory_destination_path="$(
    validate_file_destination_path "$offhost_destination"
  )"
  load_directory_mount_identity "$offhost_mount_identity_file"
  case "$directory_destination_path" in
    "$directory_mount_target"/*) ;;
    *)
      fail "directory destination must be below its persisted mount target"
      ;;
  esac
fi

require_current_directory_mount_identity() {
  local current_target=""
  local current_source=""
  local current_fstype=""
  local current_fsid_before=""
  local current_fsid_after=""

  [[ -n "$directory_destination_path" ]] || return 0

  current_fsid_before="$(stat -f -c '%i' -- "$directory_destination_path")" ||
    fail "directory destination filesystem identity is unavailable"
  current_target="$(
    read_mount_field "$directory_mount_target" TARGET
  )"
  current_source="$(
    read_mount_field "$directory_mount_target" SOURCE
  )"
  current_fstype="$(
    read_mount_field "$directory_mount_target" FSTYPE
  )"
  current_fsid_after="$(stat -f -c '%i' -- "$directory_destination_path")" ||
    fail "directory destination filesystem identity is unavailable"

  [[ "$current_target" = "$directory_mount_target" &&
    "$current_source" = "$directory_mount_source" &&
    "$current_fstype" = "$directory_mount_fstype" &&
    "$current_fsid_before" = "$directory_mount_fsid" &&
    "$current_fsid_after" = "$directory_mount_fsid" ]] ||
    fail "directory destination mount identity changed or is unavailable"
}

audit_uploader_path() {
  local candidate="$1"
  local stop_directory="$2"
  local expected_uid="$3"
  local canonical_candidate=""
  local canonical_stop=""
  local component=""
  local component_mode=""

  canonical_candidate="$(realpath -e -- "$candidate")" ||
    fail "cannot resolve off-host command path: $candidate"
  canonical_stop="$(realpath -e -- "$stop_directory")" ||
    fail "cannot resolve uploader trust root: $stop_directory"
  [[ "$candidate" = "$canonical_candidate" ]] ||
    fail "off-host command path must be canonical and contain no symlink: $candidate"

  if [[ "$canonical_stop" != "/" ]]; then
    [[ "$canonical_candidate" = "$canonical_stop/"* ]] ||
      fail "off-host command is outside its audited trust root"
  fi

  component="$canonical_candidate"
  while true; do
    [[ ! -L "$component" ]] ||
      fail "uploader path component must not be a symlink: $component"
    [[ "$(stat -c '%u' -- "$component")" -eq "$expected_uid" ]] ||
      fail "uploader path component has an untrusted owner: $component"
    component_mode="$(stat -c '%a' -- "$component")"
    (( (8#$component_mode & 0022) == 0 )) ||
      fail "uploader path component is writable by group or other: $component"

    [[ "$component" = "$canonical_stop" ]] && break
    component="${component%/*}"
    [[ -n "$component" ]] || component="/"
  done
}

[[ "$offhost_command" = /* ]] ||
  fail "off-host command must be an absolute path: $offhost_command"
[[ -f "$offhost_command" && -x "$offhost_command" ]] ||
  fail "off-host command is not an executable regular file: $offhost_command"
[[ "$offhost_generation" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] ||
  fail "off-host generation must match [A-Za-z0-9][A-Za-z0-9._:-]{0,127}"
[[ -d "$backup_dir" && ! -L "$backup_dir" ]] ||
  fail "backup directory must be an existing non-symlink directory: $backup_dir"

if [[ "$test_mode" = 1 && "$offhost_command" = "$test_root/"* ]]; then
  audit_uploader_path \
    "$offhost_command" \
    "$test_root" \
    "$(stat -c '%u' -- "$test_root")"
else
  audit_uploader_path "$offhost_command" "/" 0
fi

read -r offhost_uploader_sha256 _ < <(sha256sum -- "$offhost_command")
[[ "$offhost_uploader_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "could not calculate off-host uploader pin"

read -r offhost_destination_sha256 _ < <(
  printf '%s' "$offhost_destination" | sha256sum
)
[[ "$offhost_destination_sha256" =~ ^[0-9a-f]{64}$ ]] ||
  fail "could not calculate off-host destination identity"

active_verify_file=""
active_challenge_dir=""
active_retention_file=""
cleanup_runtime_files() {
  if [[ -n "$active_verify_file" &&
    "$active_verify_file" = "$backup_dir/.forge-offhost-verify."* ]]; then
    rm -f -- "$active_verify_file"
  fi
  if [[ -n "$active_retention_file" &&
    "$active_retention_file" = "$backup_dir/.forge-retention-list."* ]]; then
    rm -f -- "$active_retention_file"
  fi
  if [[ -n "$active_challenge_dir" &&
    "$active_challenge_dir" = "$backup_dir/.forge-recovery-challenge."* ]]; then
    rm -rf -- "$active_challenge_dir"
  fi
}
trap cleanup_runtime_files EXIT

read_exact_sha256_file() {
  local digest_file="$1"
  local digest_label="$2"
  local digest_size=""
  local -a digest_lines=()

  [[ -f "$digest_file" && ! -L "$digest_file" ]] ||
    fail "$digest_label is not a non-symlink regular file"
  digest_size="$(wc -c <"$digest_file")"
  [[ "$digest_size" -eq 64 || "$digest_size" -eq 65 ]] ||
    fail "$digest_label must contain exactly one lowercase SHA-256"
  LC_ALL=C grep -Eq '^[0-9a-f]{64}$' "$digest_file" ||
    fail "$digest_label must contain exactly one lowercase SHA-256"
  mapfile -t digest_lines <"$digest_file"
  [[ ${#digest_lines[@]} -eq 1 &&
    "${digest_lines[0]}" =~ ^[0-9a-f]{64}$ ]] ||
    fail "$digest_label must contain exactly one lowercase SHA-256"

  printf '%s' "${digest_lines[0]}"
}

run_offhost_command() {
  require_current_directory_mount_identity

  env \
    -u FORGE_SECRET_VAULT_KEY \
    -u FORGE_SECRET_VAULT_KEY_FILE \
    -u FORGE_SECRET_VAULT_PREVIOUS_KEYS \
    -u FORGE_SECRET_VAULT_PREVIOUS_KEY_FILES \
    FORGE_DIRECTORY_MOUNT_IDENTITY_FILE="$offhost_mount_identity_file" \
    "$offhost_command" "$@"
}

run_forge_command() {
  env \
    -u CREDENTIALS_DIRECTORY \
    -u FORGE_BACKUP_OFFHOST_COMMAND_FILE \
    -u FORGE_BACKUP_OFFHOST_DESTINATION_FILE \
    -u FORGE_BACKUP_OFFHOST_GENERATION_FILE \
    -u FORGE_BACKUP_OFFHOST_MOUNT_IDENTITY_FILE \
    -u FORGE_DIRECTORY_MOUNT_IDENTITY_FILE \
    "$forge_binary" "$@"
}

verify_offhost_copy() {
  local backup_object="$1"
  local expected_sha256="$2"
  local remote_sha256=""

  active_verify_file="$(mktemp "$backup_dir/.forge-offhost-verify.XXXXXX")"
  if ! run_offhost_command verify \
    --destination "$offhost_destination" \
    --object "$backup_object" >"$active_verify_file"; then
    fail "off-host verification command failed for $backup_object"
  fi
  remote_sha256="$(
    read_exact_sha256_file "$active_verify_file" "remote verification output"
  )"
  rm -f -- "$active_verify_file"
  active_verify_file=""

  [[ "$remote_sha256" = "$expected_sha256" ]] ||
    fail "remote SHA-256 mismatch for $backup_object"
}

run_recovery_challenge() {
  local backup_object="$1"
  local expected_sha256="$2"
  local downloaded_store=""
  local downloaded_digest_file=""
  local downloaded_sha256=""
  local actual_downloaded_sha256=""
  local restored_store=""

  active_challenge_dir="$(
    mktemp -d "$backup_dir/.forge-recovery-challenge.XXXXXX"
  )"
  downloaded_store="$active_challenge_dir/downloaded.sqlite"
  downloaded_digest_file="$active_challenge_dir/downloaded.sqlite.sha256"
  restored_store="$active_challenge_dir/restored.sqlite"

  if ! run_offhost_command download \
    --destination "$offhost_destination" \
    --object "$backup_object" \
    --output "$downloaded_store" \
    --sha256-output "$downloaded_digest_file" \
    >"$active_challenge_dir/download-report.txt"; then
    fail "off-host recovery download failed for $backup_object"
  fi
  [[ -f "$downloaded_store" && ! -L "$downloaded_store" ]] ||
    fail "recovery download did not create a safe store for $backup_object"

  downloaded_sha256="$(
    read_exact_sha256_file \
      "$downloaded_digest_file" \
      "downloaded remote digest"
  )"
  read -r actual_downloaded_sha256 _ < <(sha256sum -- "$downloaded_store")
  [[ "$downloaded_sha256" = "$expected_sha256" &&
    "$actual_downloaded_sha256" = "$expected_sha256" ]] ||
    fail "recovery download digest mismatch for $backup_object"

  run_forge_command --store "$downloaded_store" store check \
    --output json >"$active_challenge_dir/downloaded-check.json"
  run_forge_command --store "$restored_store" store restore \
    --source "$downloaded_store" \
    --approved-by forge-backup-recovery-challenge \
    --confirm-restore \
    --output json >"$active_challenge_dir/restore.json"
  run_forge_command --store "$restored_store" store check \
    --output json >"$active_challenge_dir/restored-check.json"

  rm -rf -- "$active_challenge_dir"
  active_challenge_dir=""
}

ensure_offhost_copy() {
  local backup_path="$1"
  local force_verify="$2"
  local backup_object="${backup_path##*/}"
  local marker_path="$backup_path.offhost-verified"
  local marker_schema=""
  local marker_backup_sha256=""
  local marker_destination_sha256=""
  local marker_generation=""
  local marker_uploader_sha256=""
  local marker_extra=""
  local marker_valid=false
  local marker_tmp=""
  local backup_sha256=""

  [[ -f "$backup_path" && ! -L "$backup_path" ]] ||
    fail "backup candidate must be a non-symlink regular file: $backup_path"
  run_forge_command --store "$backup_path" store check --output json

  read -r backup_sha256 _ < <(sha256sum -- "$backup_path")
  [[ "$backup_sha256" =~ ^[0-9a-f]{64}$ ]] ||
    fail "could not calculate SHA-256 for $backup_path"

  if [[ ( -e "$marker_path" || -L "$marker_path" ) &&
    ( ! -f "$marker_path" || -L "$marker_path" ) ]]; then
    fail "verification marker must be a non-symlink regular file: $marker_path"
  fi

  if [[ -f "$marker_path" && ! -L "$marker_path" ]]; then
    read -r \
      marker_schema \
      marker_backup_sha256 \
      marker_destination_sha256 \
      marker_generation \
      marker_uploader_sha256 \
      marker_extra \
      <"$marker_path" || true
    if [[ "$marker_schema" = "forge-offhost-v2" &&
      "$marker_backup_sha256" = "$backup_sha256" &&
      "$marker_destination_sha256" = "$offhost_destination_sha256" &&
      "$marker_generation" = "$offhost_generation" &&
      "$marker_uploader_sha256" = "$offhost_uploader_sha256" &&
      -z "$marker_extra" ]]; then
      marker_valid=true
    fi
  fi

  if [[ "$marker_valid" = false ]]; then
    # The operator-provided uploader receives only a non-secret destination. It
    # authenticates out of band. Upload must be idempotent and immutable so a
    # retry after a crash cannot overwrite a different remote object.
    run_offhost_command upload \
      --source "$backup_path" \
      --destination "$offhost_destination" \
      --object "$backup_object" \
      --sha256 "$backup_sha256"
    verify_offhost_copy "$backup_object" "$backup_sha256"
    run_recovery_challenge "$backup_object" "$backup_sha256"

    marker_tmp="$(mktemp "$backup_dir/.forge-offhost-marker.XXXXXX")"
    if ! printf '%s %s %s %s %s\n' \
      "forge-offhost-v2" \
      "$backup_sha256" \
      "$offhost_destination_sha256" \
      "$offhost_generation" \
      "$offhost_uploader_sha256" \
      >"$marker_tmp"; then
      rm -f -- "$marker_tmp"
      fail "could not write off-host verification marker for $backup_object"
    fi
    if ! mv -f -- "$marker_tmp" "$marker_path"; then
      rm -f -- "$marker_tmp"
      fail "could not promote off-host verification marker for $backup_object"
    fi
  elif [[ "$force_verify" = true ]]; then
    verify_offhost_copy "$backup_object" "$backup_sha256"
  fi
}

# Drain and challenge every retained backup without a matching marker before
# allocating space for a new snapshot. This lets recovery from an off-host
# outage free safely retained space before a full disk can block the retry.
shopt -s nullglob
local_backups=("$backup_dir"/forge-????????T??????Z.sqlite)
shopt -u nullglob
for local_backup in "${local_backups[@]}"; do
  ensure_offhost_copy "$local_backup" false
done

# Retention is intentionally narrow. Each expired object is verified remotely
# again immediately before its local backup and marker are removed.
active_retention_file="$(mktemp "$backup_dir/.forge-retention-list.XXXXXX")"
if ! find "$backup_dir" \
  -maxdepth 1 \
  -type f \
  -name 'forge-????????T??????Z.sqlite' \
  -mtime "+$local_retention_days" \
  -print0 >"$active_retention_file"; then
  fail "could not enumerate local backup retention candidates"
fi
while IFS= read -r -d '' expired_backup; do
  ensure_offhost_copy "$expired_backup" true
  rm -f -- "$expired_backup" "$expired_backup.offhost-verified"
done <"$active_retention_file"
rm -f -- "$active_retention_file"
active_retention_file=""

if [[ "$test_mode" = 1 && -n "${FORGE_BACKUP_TEST_TIMESTAMP:-}" ]]; then
  timestamp="$FORGE_BACKUP_TEST_TIMESTAMP"
else
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
fi
[[ "$timestamp" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] ||
  fail "backup timestamp must match YYYYMMDDTHHMMSSZ"
object_name="forge-$timestamp.sqlite"
destination="$backup_dir/$object_name"

run_forge_command --store "$store" store check --output json
require_current_directory_mount_identity
run_forge_command --store "$store" store backup \
  --destination "$destination" \
  --output json
ensure_offhost_copy "$destination" false

printf 'forge backup: drain, remote recovery challenge, snapshot, and retention succeeded\n'
