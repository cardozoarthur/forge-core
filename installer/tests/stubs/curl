#!/usr/bin/env bash
set -euo pipefail

output=""
url=""
while (($#)); do
  case "$1" in
    -o)
      output="${2:-}"
      shift 2
      ;;
    --proto)
      shift 2
      ;;
    --tlsv1.2|-*)
      shift
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done

[[ -n "$output" && -n "$url" ]]
asset="${url##*/}"
printf '%s\n' "$asset" >>"$FOUNDRY_TEST_DOWNLOAD_LOG"
[[ -f "$FOUNDRY_TEST_RELEASE_DIR/$asset" ]] || exit 22
cp -- "$FOUNDRY_TEST_RELEASE_DIR/$asset" "$output"
